{
  "expo": {
    "name": "JapLearn",
    "slug": "japlearn",
    "scheme": "japlearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/APPLOGO_ICON_1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/APPLOGO_SPLASH_1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F3FC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/APPLOGO_ADAPTIVE_1024.png",
        "backgroundColor": "#F8F3FC"
      },
      "package": "com.japlearn.cit"
    },
    "web": {
      "favicon": "./assets/APPLOGO.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "eee8a62c-404c-4a0d-816d-29b3ccbf11a0"
      }
    },
    "owner": "reybacolod"
  }
}
